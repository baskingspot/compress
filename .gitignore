bench-results/
bench/corpus-gen/
zig-pkg/
.zig-cache/
zig-out/
.bench-cache/

# Core dumps (qemu-user writes qemu_<prog>_<time>_<pid>.core) carry the full
# process environment, secrets included. Never commit them.
*.core
core
core.[0-9]*
*.out
*.o
*.zst
# Test fixtures that tests embed with @embedFile. Without these a fresh clone cannot compile its tests.
!src/zstd/testdata/*.zst
*.z
*.snappy

# The link baskingspot-docs makes to the theme.
docs/themes/
.wrangler/

# direnv state and local overrides.
.direnv/
.envrc.local

# The API reference zig build docs installs (a build product).
docs/static/api/
